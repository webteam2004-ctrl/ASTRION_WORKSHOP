# ==============================================================================
# ASTRION 2K26 Workshop Backend - Environment Configuration
# ==============================================================================

# Server Port
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=development

# Allowed Frontend URLs for CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173,https://astrion2k26-iic.vercel.app

# Supabase Credentials (Found in Supabase Dashboard -> Project Settings -> API)
# IMPORTANT: Never commit actual keys to version control!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_REGISTRATIONS_TABLE=registrations

# Resend Email Configuration (Node.js SDK)
# Obtain your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key

# Verified Sender Address on your authenticated domain (e.g., registrations@your-domain.com)
EMAIL_FROM=ASTRION 2K26 <registrations@your-verified-domain.com>

# Official contact / reply-to address
EMAIL_REPLY_TO=your-official-contact@example.com
